package build.examples.`05-flink-kafka-s3sink`

import mill.*
import mill.scalalib.*
import build.*

/**
 * Example 05: Apache Flink reads Order events from Apache Kafka, groups them per customer into event-time windows and
 * writes one JSON file per window to S3-compatible object storage.
 *
 * Scala 2.12 is not a stylistic choice: the Apache Flink connectors and the Flink Scala helpers are still published for
 * Scala 2.12 only, and a Flink cluster puts a Scala 2.12 runtime on the classpath of every job it runs.
 */
/** Versions pinned by this example only, so the root build stays untouched. */
object ExampleVersions {
  val flink               = "1.20.1"
  val flinkKafkaConnector = "3.4.0-1.20"
  val circe               = "0.14.10"
}

object `package` extends BaseScalaModule {

  def scalaVersion = Versions.scala212

  def moduleDeps = Seq(build.common(Versions.scala212))

  /**
   * Dependencies that are compiled against but NOT packaged into the job jar. A Flink cluster already provides these;
   * shipping a second copy inside the jar leads to class loading conflicts.
   */
  def compileMvnDeps = Seq(
    mvn"org.apache.flink:flink-streaming-java:${ExampleVersions.flink}",
    mvn"org.apache.flink:flink-clients:${ExampleVersions.flink}",
    mvn"org.apache.flink:flink-connector-files:${ExampleVersions.flink}"
  )

  /** Dependencies that the cluster does not provide and that must be shipped. */
  def mvnDeps = Seq(
    mvn"org.apache.flink:flink-connector-kafka:${ExampleVersions.flinkKafkaConnector}",
    mvn"org.apache.kafka:kafka-clients:3.9.0",
    mvn"io.circe::circe-core:${ExampleVersions.circe}",
    mvn"io.circe::circe-parser:${ExampleVersions.circe}"
  )

  def mainClass = Some("de.flink.s3sink.job.Main")

  object test extends ScalaTests with MunitTests with mill.scalalib.scalafmt.ScalafmtModule {

    /** The pure core needs no Flink at all, but the harness tests do. */
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.apache.flink:flink-streaming-java:${ExampleVersions.flink}",
      mvn"org.apache.flink:flink-clients:${ExampleVersions.flink}",
      mvn"org.apache.flink:flink-connector-files:${ExampleVersions.flink}",
      mvn"org.apache.flink:flink-test-utils:${ExampleVersions.flink}",
      mvn"org.apache.flink:flink-streaming-java:${ExampleVersions.flink};classifier=tests",
      mvn"org.apache.flink:flink-runtime:${ExampleVersions.flink};classifier=tests"
    )
  }
}
