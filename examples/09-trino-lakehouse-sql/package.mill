package build.examples.`09-trino-lakehouse-sql`

import mill.*
import mill.scalalib.*
import build.*

/**
 * Example 09 - Trino as the query engine over a lakehouse, driven from Scala 3.
 *
 * The only library this module needs is the Trino JDBC (Java Database Connectivity) driver: everything the example
 * demonstrates - the Delta Lake connector, the PostgreSQL connector, the cross-catalog join - happens inside the Trino
 * cluster and reaches Scala as plain SQL over one connection.
 *
 * The driver is a single self-contained ("shaded") jar, which is why there is nothing else on the classpath here.
 */
object `package` extends BaseScalaModule {
  def scalaVersion = Versions.scala3

  def moduleDeps = Seq(build.common(Versions.scala3))

  def mvnDeps = Seq(mvn"io.trino:trino-jdbc:476")

  def mainClass = Some("de.trino.lakehouse.Main")

  object test extends ScalaTests with MunitTests {}
}
