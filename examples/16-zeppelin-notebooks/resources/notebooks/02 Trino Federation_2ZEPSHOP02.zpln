    {
      "title": "Revenue per article, computed by Trino",
      "text": "%jdbc\n-- Exactly the join from note 01, this time executed by Trino rather than Spark. Same files,\n-- same answer, a different engine - which is the property that makes a lakehouse worth having.\nSELECT\n  l.sku,\n  sum(l.quantity)                                          AS units,\n  round(sum(l.quantity * l.unit_price_cents) / 100.0, 2)   AS revenue_eur\nFROM delta.shop.order_lines l\nJOIN delta.shop.orders o ON o.order_id = l.order_id\nGROUP BY l.sku\nORDER BY revenue_eur DESC\n",
      "user": "anonymous",
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
