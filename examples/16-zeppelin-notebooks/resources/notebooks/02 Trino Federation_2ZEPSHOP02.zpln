    {
      "title": "What Trino can see",
      "text": "%jdbc\n-- A catalog is one data source Trino has been told about. This stack configures a single one,\n-- `delta`, pointing at the Delta Lake tables in MinIO through a Hive Metastore.\nSHOW TABLES FROM delta.shop\n",
      "user": "anonymous",
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "fontSize": 9.0,
        "editorHide": false,
        "title": true,
        "results": {},
        "enabled": true,
        "runOnSelectionChange": true,
        "checkEmpty": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_20250101-000011_2001",
      "id": "20250101-000011_2001",
      "dateCreated": "2025-01-01 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "Revenue by country",
      "text": "%jdbc\n-- Dynamic forms are a Zeppelin feature, not a Spark one: they work in front of any interpreter,\n-- including this one. The dropdown value is substituted into the text before the SQL is sent.\nSELECT\n  country,\n  count(*)                                    AS orders,\n  round(sum(total_cents) / 100.0, 2)          AS revenue_eur,\n  round(avg(total_cents) / 100.0, 2)          AS average_order_eur\nFROM delta.shop.orders\nWHERE country <> '${exclude_country=ES,DE|PL|UA|FR|ES}'\nGROUP BY country\nORDER BY revenue_eur DESC\n",
      "user": "anonymous",
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
